{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/output-manifest.schema.json",
  "title": "FreeCAD Automation Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command",
    "command_args",
    "input",
    "repo",
    "runtime",
    "timings",
    "outputs",
    "linked_artifacts",
    "warnings",
    "errors",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "command_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "$ref": "#/$defs/fileRecord"
    },
    "effective_input": {
      "$ref": "#/$defs/effectiveInput"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "branch",
        "head_sha",
        "dirty_at_start"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_at_start": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_version",
        "platform",
        "freecad_available",
        "freecad_executable_detected",
        "freecad_probe_status",
        "freecad_status",
        "freecad_version"
      ],
      "properties": {
        "node_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "freecad_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "freecad_executable_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "freecad_probe_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "freecad_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "freecad_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outputRecord"
      }
    },
    "linked_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa_json",
        "run_log_json",
        "traceability_json",
        "report_pdf",
        "quality_json"
      ],
      "properties": {
        "qa_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_log_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "traceability_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "planner_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "extracted_drawing_semantics_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_pdf": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_summary_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "drawing_intent_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_catalog_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_feedback_json": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "unknown"
      ]
    }
  },
  "$defs": {
    "effectiveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authored_config_kind",
        "runtime_config_kind",
        "sources",
        "recipe"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "authored_config_kind": { "type": "string", "minLength": 1 },
        "runtime_config_kind": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256", "size_bytes"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "path": { "$ref": "#/$defs/fileRecord/properties/path" },
              "sha256": { "$ref": "#/$defs/fileRecord/properties/sha256" },
              "size_bytes": { "$ref": "#/$defs/fileRecord/properties/size_bytes" }
            }
          }
        },
        "recipe": {
          "oneOf": [
            { "$ref": "#/$defs/createRecipe" },
            { "$ref": "#/$defs/drawServiceRecipe" },
            { "$ref": "#/$defs/drawPipelineRecipe" }
          ]
        }
      }
    },
    "nullableNonemptyString": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "createRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "create-v1" }
      }
    },
    "drawServiceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "standard", "dxf_export", "preset", "weights_preset", "postprocess", "qa"],
      "properties": {
        "kind": { "const": "draw-service-v1" },
        "standard": { "type": "string", "minLength": 1 },
        "dxf_export": { "type": "boolean" },
        "preset": { "$ref": "#/$defs/nullableNonemptyString" },
        "weights_preset": { "$ref": "#/$defs/nullableNonemptyString" },
        "postprocess": { "type": "boolean" },
        "qa": { "type": "boolean" }
      }
    },
    "drawPipelineRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "bom", "no_plan", "plan_status", "standard", "weights_preset",
        "raw", "no_score", "fail_under", "override", "unsupported_flags", "working_directory"
      ],
      "properties": {
        "kind": { "const": "draw-pipeline-v1" },
        "bom": { "type": "boolean" },
        "no_plan": { "type": "boolean" },
        "plan_status": { "enum": ["applied", "skipped", "failed"] },
        "standard": { "type": "string", "minLength": 1 },
        "weights_preset": { "$ref": "#/$defs/nullableNonemptyString" },
        "raw": { "type": "boolean" },
        "no_score": { "type": "boolean" },
        "fail_under": { "type": ["string", "number", "null"] },
        "override": { "type": "boolean" },
        "unsupported_flags": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string", "minLength": 1 }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "outputRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "exists",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
