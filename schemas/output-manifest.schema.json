{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/output-manifest.schema.json",
  "title": "FreeCAD Automation Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "command",
    "command_args",
    "input",
    "repo",
    "runtime",
    "timings",
    "outputs",
    "linked_artifacts",
    "warnings",
    "errors",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "command_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "$ref": "#/$defs/fileRecord"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "branch",
        "head_sha",
        "dirty_at_start"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_at_start": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_version",
        "platform",
        "freecad_available",
        "freecad_executable_detected",
        "freecad_probe_status",
        "freecad_status",
        "freecad_version"
      ],
      "properties": {
        "node_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "freecad_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "freecad_executable_detected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "freecad_probe_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "freecad_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "freecad_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outputRecord"
      }
    },
    "linked_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa_json",
        "run_log_json",
        "traceability_json",
        "report_pdf",
        "quality_json"
      ],
      "properties": {
        "qa_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_log_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "traceability_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "planner_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "extracted_drawing_semantics_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_pdf": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_summary_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "drawing_intent_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_catalog_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_feedback_json": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "unknown"
      ]
    },
    "effective_policy": {
      "$ref": "#/$defs/effectivePolicy"
    },
    "revision_lineage": {
      "$ref": "#/$defs/revisionLineage"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["effective_policy", "status"],
        "properties": {
          "status": { "enum": ["pass", "warning"] },
          "effective_policy": {
            "required": ["proof_lineage"],
            "properties": {
              "proof_lineage": { "const": true }
            }
          }
        }
      },
      "then": {
        "required": ["revision_lineage"]
      }
    }
  ],
  "$defs": {
    "effectivePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_lineage"],
      "properties": {
        "proof_lineage": { "type": "boolean" }
      }
    },
    "revisionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "identity", "parents"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "mode": { "const": "proof" },
        "identity": { "$ref": "#/$defs/revisionLineageIdentity" },
        "parents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/revisionLineageParent" }
        }
      }
    },
    "revisionLineageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_slug", "part_id", "revision", "config_sha256"],
      "properties": {
        "package_slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "part_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "revisionLineageParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "role", "path", "sha256"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "outputRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "exists",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
