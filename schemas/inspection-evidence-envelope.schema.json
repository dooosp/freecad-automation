{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dooosp.github.io/freecad-automation/schemas/inspection-evidence-envelope.schema.json",
  "title": "Inspection Evidence Envelope",
  "description": "Lifecycle envelope for a genuine physical, supplier, lab, or QA inspection record. Structural validity is not authorization or attachment.",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "evidence_id",
    "synthetic",
    "lifecycle_state",
    "package",
    "subject",
    "source",
    "inspection",
    "review",
    "authorization",
    "measured_characteristics",
    "specification_references",
    "provenance",
    "attachment",
    "confidentiality"
  ],
  "properties": {
    "artifact_type": { "const": "inspection_evidence_envelope" },
    "schema_version": { "const": "1.0" },
    "evidence_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "synthetic": { "type": "boolean" },
    "lifecycle_state": {
      "enum": [
        "discovered",
        "quarantined",
        "structurally_valid",
        "semantically_valid",
        "awaiting_authorization",
        "authorized",
        "attached",
        "rejected",
        "superseded"
      ]
    },
    "package": {
      "type": "object",
      "required": ["slug", "revision"],
      "properties": {
        "slug": { "$ref": "#/$defs/token" },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["identifier", "identifier_type", "revision"],
      "properties": {
        "identifier": { "$ref": "#/$defs/nonPlaceholder" },
        "identifier_type": { "enum": ["part", "drawing", "assembly", "lot"] },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["organization", "source_type", "source_record_id", "document"],
      "properties": {
        "organization": { "$ref": "#/$defs/nonPlaceholder" },
        "source_type": { "enum": ["physical", "supplier", "lab", "qa"] },
        "source_record_id": { "$ref": "#/$defs/nonPlaceholder" },
        "document": {
          "type": "object",
          "required": ["original_filename", "media_type", "size_bytes", "sha256"],
          "properties": {
            "original_filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^/\\\\]+$"
            },
            "media_type": {
              "enum": ["application/json", "text/csv"]
            },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "required": ["method", "status", "completed_at", "inspector_identity_ref", "overall_result"],
      "properties": {
        "method": { "$ref": "#/$defs/nonPlaceholder" },
        "status": { "enum": ["complete", "completed", "final", "released", "approved"] },
        "completed_at": { "$ref": "#/$defs/dateTime" },
        "inspector_identity_ref": { "$ref": "#/$defs/identityRef" },
        "overall_result": { "enum": ["pass", "fail", "partial"] }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["reviewer_identity_ref", "reviewed_at", "decision"],
      "properties": {
        "reviewer_identity_ref": { "$ref": "#/$defs/identityRef" },
        "reviewed_at": { "$ref": "#/$defs/dateTime" },
        "decision": { "const": "approved_for_authorization" },
        "notes": { "type": ["string", "null"], "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["status", "authorization_id", "record_ref", "record_sha256", "authorized_by_ref", "authorized_at", "operation_scope"],
      "properties": {
        "status": { "enum": ["pending", "authorized"] },
        "authorization_id": { "type": ["string", "null"], "minLength": 3, "maxLength": 128 },
        "record_ref": {
          "anyOf": [
            { "$ref": "#/$defs/safeRelativePath" },
            { "type": "null" }
          ]
        },
        "record_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "authorized_by_ref": {
          "anyOf": [
            { "$ref": "#/$defs/identityRef" },
            { "type": "null" }
          ]
        },
        "authorized_at": {
          "anyOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "operation_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["attach"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "authorized" } } },
          "then": {
            "properties": {
              "authorization_id": { "type": "string", "minLength": 3 },
              "record_ref": { "$ref": "#/$defs/safeRelativePath" },
              "record_sha256": { "$ref": "#/$defs/sha256" },
              "authorized_by_ref": { "$ref": "#/$defs/identityRef" },
              "authorized_at": { "$ref": "#/$defs/dateTime" },
              "operation_scope": { "contains": { "const": "attach" }, "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "authorization_id": { "type": "null" },
              "record_ref": { "type": "null" },
              "record_sha256": { "type": "null" },
              "authorized_by_ref": { "type": "null" },
              "authorized_at": { "type": "null" },
              "operation_scope": { "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "measured_characteristics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["characteristic_id", "specification_ref", "measured_value", "unit", "result"],
        "properties": {
          "characteristic_id": { "$ref": "#/$defs/nonPlaceholder" },
          "specification_ref": { "$ref": "#/$defs/nonPlaceholder" },
          "nominal_value": { "type": ["number", "string", "null"] },
          "measured_value": { "type": ["number", "string", "boolean"] },
          "unit": { "$ref": "#/$defs/nonPlaceholder" },
          "lower_limit": { "type": ["number", "null"] },
          "upper_limit": { "type": ["number", "null"] },
          "result": { "enum": ["pass", "fail", "not_accepted"] }
        },
        "additionalProperties": false
      }
    },
    "specification_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonPlaceholder" }
    },
    "provenance": {
      "type": "object",
      "required": ["immutable", "origin_reference", "received_at", "custody_events"],
      "properties": {
        "immutable": { "const": true },
        "origin_reference": { "$ref": "#/$defs/nonPlaceholder" },
        "received_at": { "$ref": "#/$defs/dateTime" },
        "custody_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event_type", "occurred_at", "actor_ref", "source_sha256"],
            "properties": {
              "event_type": { "enum": ["received", "quarantined", "reviewed", "authorized", "attached"] },
              "occurred_at": { "$ref": "#/$defs/dateTime" },
              "actor_ref": { "$ref": "#/$defs/identityRef" },
              "source_sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["requested_at", "attached_at"],
      "properties": {
        "requested_at": { "$ref": "#/$defs/dateTime" },
        "attached_at": {
          "anyOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "confidentiality": {
      "type": "object",
      "required": ["classification", "redaction_status", "redacted_fields"],
      "properties": {
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "redaction_status": { "enum": ["not_required", "redacted", "reviewed_no_redaction"] },
        "redacted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["classification"],
            "properties": { "classification": { "enum": ["confidential", "restricted"] } }
          },
          "then": { "properties": { "redaction_status": { "enum": ["redacted", "reviewed_no_redaction"] } } }
        },
        {
          "if": {
            "required": ["redaction_status"],
            "properties": { "redaction_status": { "const": "redacted" } }
          },
          "then": { "properties": { "redacted_fields": { "minItems": 1 } } },
          "else": { "properties": { "redacted_fields": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "nonPlaceholder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "identityRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^(?!unknown$)(?!null$)(?!n/a$)[A-Za-z0-9][A-Za-z0-9._:@+-]+$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  },
  "additionalProperties": false
}
