{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/manufacturing-episode-annotation.schema.json",
  "title": "Synthetic Manufacturing Episode Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "generated_at",
    "identity",
    "revision_lineage",
    "source_snapshots",
    "boundaries",
    "source",
    "annotation_origin",
    "confidence",
    "action_dictionary",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "manufacturing_episode_annotation"
    },
    "artifact_id": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/artifactId"
    },
    "generated_at": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/timestamp"
    },
    "identity": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/identity"
    },
    "revision_lineage": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/revisionLineage"
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/sourceSnapshot"
      }
    },
    "boundaries": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/boundaries"
    },
    "source": {
      "const": "synthetic_task_timeline"
    },
    "annotation_origin": {
      "const": "curated_task_plan"
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "applicability",
        "rationale"
      ],
      "properties": {
        "value": {
          "type": "null"
        },
        "applicability": {
          "const": "not_applicable"
        },
        "rationale": {
          "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/nonEmptyText"
        }
      }
    },
    "action_dictionary": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/hashRecord"
    },
    "segments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "order",
          "action_id",
          "start_ms",
          "end_ms",
          "duration_ms",
          "instruction",
          "human_review_required"
        ],
        "properties": {
          "segment_id": {
            "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/stableId"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "action_id": {
            "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/stableId"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "instruction": {
            "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/localizedInstruction"
          },
          "human_review_required": {
            "const": true
          }
        }
      }
    }
  }
}
