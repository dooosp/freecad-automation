{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/manufacturing-action-dictionary.schema.json",
  "title": "Manufacturing Action Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "generated_at",
    "identity",
    "revision_lineage",
    "source_snapshots",
    "source_universe",
    "boundaries",
    "actions",
    "unresolved_requirements"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "manufacturing_action_dictionary"
    },
    "artifact_id": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/artifactId"
    },
    "generated_at": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/timestamp"
    },
    "identity": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/identity"
    },
    "revision_lineage": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/revisionLineage"
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/sourceSnapshot"
      }
    },
    "source_universe": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/sourceUniverse"
    },
    "boundaries": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/boundaries"
    },
    "actions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/actionDefinition"
      }
    },
    "unresolved_requirements": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/unresolvedRequirement"
      }
    }
  }
}
