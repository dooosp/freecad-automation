{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/qif-lite-inspection-adapter-report.schema.json",
  "title": "QIF-Lite Inspection Adapter Report",
  "description": "Contract for the narrow XML-to-inspection-evidence adapter. A valid report only identifies an attachment-ready candidate; it does not attach XML evidence by default.",
  "type": "object",
  "required": [
    "schema_version",
    "adapter",
    "source_ref",
    "classification",
    "inspection_evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "adapter": { "const": "qif-lite" },
    "source_ref": { "$ref": "#/$defs/safeRelativePath" },
    "classification": {
      "type": "object",
      "required": [
        "attachment_ready_candidate",
        "rejection_reasons"
      ],
      "properties": {
        "attachment_ready_candidate": { "type": "boolean" },
        "rejection_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "inspection_evidence": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/inspectionEvidence" }
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": ["classification"],
        "properties": {
          "classification": {
            "required": ["attachment_ready_candidate"],
            "properties": {
              "attachment_ready_candidate": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "inspection_evidence": {
            "type": "object",
            "required": [
              "package_id",
              "inspected_part",
              "inspected_at"
            ],
            "properties": {
              "package_id": { "type": "string", "minLength": 1 },
              "inspected_part": { "type": "string", "minLength": 1 },
              "inspected_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!output(?:/|$))(?!tmp/codex(?:/|$))(?!local/stage5b-candidate-evidence-inbox(?:/|$)).+$"
    },
    "inspectionEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_type",
        "source_type",
        "package_id",
        "inspected_part",
        "inspected_at",
        "units",
        "measurement_system",
        "overall_result",
        "source_ref",
        "measured_features"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "evidence_type": { "const": "inspection_evidence" },
        "source_type": {
          "enum": [
            "cmm_report",
            "manual_caliper_check",
            "go_no_go_gauge",
            "first_article_inspection",
            "supplier_inspection_report",
            "other_inspection_source"
          ]
        },
        "package_id": { "type": ["string", "null"], "minLength": 1 },
        "inspected_part": { "type": ["string", "null"], "minLength": 1 },
        "inspected_at": { "type": ["string", "null"], "minLength": 1 },
        "inspection_status": { "type": "string", "minLength": 1 },
        "inspector": { "type": ["string", "null"] },
        "reviewed_by": { "type": ["string", "null"] },
        "part_revision": { "type": ["string", "null"] },
        "units": { "type": "string", "minLength": 1 },
        "measurement_system": {
          "enum": [
            "metric",
            "imperial",
            "mixed",
            "unknown"
          ]
        },
        "overall_result": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "unknown"
          ]
        },
        "source_ref": { "$ref": "#/$defs/safeRelativePath" },
        "measured_features": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measuredFeature" }
        }
      },
      "additionalProperties": true
    },
    "measuredFeature": {
      "type": "object",
      "required": [
        "feature_id",
        "measured_value",
        "result",
        "measurement_method"
      ],
      "properties": {
        "feature_id": { "type": "string", "minLength": 1 },
        "nominal_value": { "type": ["number", "string", "null"] },
        "measured_value": { "type": ["number", "string", "boolean", "null"] },
        "tolerance_lower": { "type": ["number", "string", "null"] },
        "tolerance_upper": { "type": ["number", "string", "null"] },
        "units": { "type": ["string", "null"] },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_measured",
            "unknown"
          ]
        },
        "measurement_method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
