{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad-automation.local/schemas/manufacturing-robotics-dataset-manifest.schema.json",
  "title": "Synthetic Manufacturing Robotics Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "generated_at",
    "identity",
    "revision_lineage",
    "source_snapshots",
    "boundaries",
    "dataset",
    "members"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/schemaVersion"
    },
    "artifact_type": {
      "const": "manufacturing_robotics_dataset_manifest"
    },
    "artifact_id": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/artifactId"
    },
    "generated_at": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/timestamp"
    },
    "identity": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/identity"
    },
    "revision_lineage": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/revisionLineage"
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/sourceSnapshot"
      }
    },
    "boundaries": {
      "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/boundaries"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "annotation_origin",
        "action_count",
        "segment_count"
      ],
      "properties": {
        "source": {
          "const": "synthetic_task_timeline"
        },
        "annotation_origin": {
          "const": "curated_task_plan"
        },
        "action_count": {
          "const": 10
        },
        "segment_count": {
          "const": 10
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "https://freecad-automation.local/schemas/manufacturing-action-common.schema.json#/$defs/hashRecord"
      }
    }
  }
}
